{
  "manifest_version": 3,
  "name": "VDM - Bắt link tải",
  "short_name": "VDM",
  "version": "1.3.2",
  "description": "Gửi link tải và video đang phát sang phần mềm VDM trên máy để tải nhanh, tải tiếp được.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_title": "VDM",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "background": { "scripts": ["shared.js", "background.js"] },
  "permissions": ["downloads", "cookies", "webRequest", "contextMenus", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["shared.js", "content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "vdm-downloader@vdm.local", "strict_min_version": "128.0" }
  }
}
